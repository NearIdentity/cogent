# Login of the cogent chat web app (src/kg_chat_app.py web). Copy to .env (git-ignored) and fill in; then: chmod 600 .env
CHAT_USERNAME=your-user-name
CHAT_PASSWORD=a-long-passphrase-of-your-own
# Better than a plaintext password: make a hash with `python src/kg_chat_app.py hash-password` and use this line INSTEAD of CHAT_PASSWORD
# CHAT_PASSWORD_HASH=
# Optional: keeps logins valid when the app restarts (any long random string)
# FLASK_SECRET_KEY=
