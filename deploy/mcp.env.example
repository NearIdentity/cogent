# /etc/cogent/mcp.env  (mode 600, owner root or the cogent user). Read by cogent-mcp.service.
COGENT_HOME=/var/lib/cogent
# the public name of the server (the named tunnel's hostname, or your Caddy domain): used for the Host check and the OAuth issuer
COGENT_PUBLIC_HOST=mcp.example.com
# one static access token (optional; or create tokens with `kg_mcp.py token create --name <client>`)
#COGENT_MCP_TOKEN=
# the READ-ONLY database login (cogent_ro), never the owner
COGENT_TABLEDB_DSN=postgresql://cogent_ro:CHANGE_ME@127.0.0.1:5432/cogent
COGENT_EMBEDDER=ollama
