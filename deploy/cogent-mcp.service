[Unit]
Description=cogent knowledge-graph MCP server
After=network.target

[Service]
User=cogent
WorkingDirectory=/opt/cogent
# create /etc/cogent/mcp.env first (optional): COGENT_MCP_TOKEN=...   (or use `kg_mcp.py token create`)
EnvironmentFile=-/etc/cogent/mcp.env
ExecStart=/opt/cogent/.venv/bin/python src/kg_mcp.py --home /var/lib/cogent serve --standards config/standards.json --reports config/reports.json --public-host kg.example.com --oauth-issuer https://kg.example.com
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cogent/mcp   # tokens.json, oauth.json
PrivateTmp=true

[Install]
WantedBy=multi-user.target
