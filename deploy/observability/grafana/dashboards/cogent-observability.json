    {
      "id": 11,
      "type": "timeseries",
      "title": "Agent operation latency over time (p50 / p95)",
      "description": "From the cumulative histograms, over a 15 minute window of runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "cogent-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cogent-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, op) (increase(cogent_agent_operation_duration_seconds_bucket[15m])))",
          "legendFormat": "{{op}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cogent-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, op) (increase(cogent_agent_operation_duration_seconds_bucket[15m])))",
          "legendFormat": "{{op}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
